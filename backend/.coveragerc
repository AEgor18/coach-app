[run]
source = core,crud,models,routers,schemas,services
omit = 
    */venv/*
    */__pycache__/*
    */tests/*
    */migrations/*
    */.pytest_cache/*
    main.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    raise AssertionError
    raise NotImplementedError
    if TYPE_CHECKING:
    class .*\(.*\):

[html]
directory = htmlcov
title = Coach App - Test Coverage

[xml]
output = coverage.xml